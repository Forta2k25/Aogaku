rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/transcriptionUploads/{fileName} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType == 'audio/mp4'
        && fileName.matches('^[A-Za-z0-9-]+\\.m4a$');
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow read: if false;
    }
    // avatars/<uid>.jpg を許可（<uid>.jpg 全体を {file} で受ける）
    match /avatars/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && file == (request.auth.uid + '.jpg');  // 自分の <uid>.jpg のみ可
    }

    match /ai-inputs/{path=**} { allow read, write: if false; }
    match /ai-derived/{path=**} { allow read, write: if false; }
  }
}
