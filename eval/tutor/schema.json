{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-grounded tutor evaluation case",
  "type": "object",
  "required": ["id", "version", "split", "familyId", "tags", "images", "context", "questions", "rubric", "suggestionAnchors"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "split": {"enum": ["dev", "holdout"]},
    "familyId": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "images": {"type": "array", "items": {"type": "string", "pattern": "^[^/\\\\]+$"}},
    "context": {"type": "array", "items": {"type": "object", "required": ["title", "text"], "properties": {"title": {"type": "string"}, "text": {"type": "string"}}}},
    "questions": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1}},
    "legacyCase": {"type": "integer", "minimum": 1, "maximum": 8},
    "rubric": {"type": "object", "required": ["grounding", "correctness", "task_completion", "uncertainty"], "additionalProperties": {"type": "string", "minLength": 1}},
    "suggestionAnchors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["gate", "kind"], "properties": {"gate": {"enum": ["grounding", "correctness", "task_completion", "uncertainty"]}, "kind": {"enum": ["includes", "excludes", "any"]}, "value": {"type": "string", "minLength": 1}, "values": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "allOf": [{"if": {"properties": {"kind": {"const": "any"}}}, "then": {"required": ["values"]}, "else": {"required": ["value"]}}]}}
  }
}
