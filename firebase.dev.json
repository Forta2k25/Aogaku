      "python3 \"$PROJECT_DIR/scripts/check_firebase_deploy_target.py\" \"$GCLOUD_PROJECT\""
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": [
      "python3 \"$PROJECT_DIR/scripts/check_firebase_deploy_target.py\" \"$GCLOUD_PROJECT\""
    ]
  }
}
